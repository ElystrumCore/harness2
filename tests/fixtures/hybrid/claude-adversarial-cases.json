  {
    "id": "oc-nonzero-exit-stop",
    "target": "opencode",
    "value": {
      "events": [
        {
          "type": "text",
          "part": {
            "text": "done"
          }
        },
        {
          "type": "step_finish",
          "part": {
            "reason": "stop"
          }
        }
      ],
      "exit_code": 1
    },
    "expected": "refuse",
    "why": "Only zero-exit complete executions can succeed, and this run exited with code 1.",
    "accepted": false,
    "parser_error": null
  },
  {
    "id": "oc-write-failure-then-stop",
    "target": "opencode",
    "value": {
      "events": [
        {
          "type": "tool_use",
          "part": {
            "tool": "write",
            "state": {
              "status": "error",
              "input": {
                "path": "notes.txt"
              },
              "error": "permission denied"
            }
          }
        },
        {
          "type": "step_finish",
          "part": {
            "reason": "stop"
          }
        }
      ],
      "exit_code": 0
    },
    "expected": "refuse",
    "why": "Write failures are fatal and cannot be cleared by a later terminal stop.",
    "accepted": false,
    "parser_error": null
  },
  {
    "id": "oc-tool-after-terminal",
    "target": "opencode",
    "value": {
      "events": [
        {
          "type": "step_finish",
          "part": {
            "reason": "end_turn"
          }
        },
        {
          "type": "tool_use",
          "part": {
            "tool": "read",
            "state": {
              "status": "completed",
              "input": {
                "path": "notes.txt"
              },
              "output": "x"
            }
          }
        }
      ],
      "exit_code": 0
    },
    "expected": "refuse",
    "why": "A tool call after a terminal step_finish cannot borrow the earlier success.",
    "accepted": true,
    "parser_error": null
  },
  {
    "id": "oc-unknown-event-part",
    "target": "opencode",
    "value": {
      "events": [
        {
          "type": "telemetry",
          "part": "opaque"
        },
        {
          "type": "step_finish",
          "part": {
            "reason": "stop"
          }
        }
      ],
      "exit_code": 0
    },
    "expected": "refuse",
    "why": "Unknown event types and malformed parts must refuse rather than be ignored.",
    "accepted": true,
    "parser_error": null
  },
