  {
    "id": "req-tool-use-in-user",
    "target": "request",
    "value": {
      "model": "claude-haiku-5-5",
      "max_tokens": 32,
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "tool_use",
              "id": "toolu_1",
              "name": "read",
              "input": {
                "path": "notes.txt"
              }
            }
          ]
        }
      ]
    },
    "expected": "refuse",
    "why": "tool_use blocks are only valid in assistant-role messages.",
    "accepted": true,
    "parser_error": null
  },
  {
    "id": "req-tool-result-no-id",
    "target": "request",
    "value": {
      "model": "claude-haiku-5-5",
      "max_tokens": 32,
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "tool_result",
              "content": "ok"
            }
          ]
        }
      ]
    },
    "expected": "refuse",
    "why": "tool_result requires a nonempty tool_use_id.",
    "accepted": true,
    "parser_error": null
  },
  {
